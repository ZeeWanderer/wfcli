/* Shared content surfaces and Mastery page chrome. */

QWidget#contentFrame {
  background: transparent;
  border: none;
}

QWidget#summaryPanel {
  background: #20283e;
  border: none;
  border-radius: 8px;
}

QWidget#masterySummaryPanel {
  background: #20283e;
  border: none;
  border-radius: 10px;
}

QWidget#masterySummaryHeader {
  background: #313a58;
  border-radius: 10px 10px 0 0;
  min-height: 40px;
  max-height: 40px;
}

QLabel#masterySummaryHeading {
  color: #ffffff;
  font-size: 12pt;
  font-weight: 400;
}

QLabel#masterySummaryPercent {
  color: #b59dff;
  font-size: 12pt;
  font-weight: 400;
}

QLabel#masterySummaryRowLabel {
  color: #ffffff;
  font-size: 11pt;
  font-weight: 400;
}

QLabel#masterySummaryRowValue {
  color: #ffffff;
  font-size: 10.5pt;
  font-weight: 300;
}

QWidget#masteryBottom {
  background: #101623;
  border: none;
  border-top-left-radius: 15px;
  border-top-right-radius: 15px;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

QLabel#masterySectionTitle {
  color: #ffffff;
  font-size: 13pt;
  font-weight: 400;
}

QWidget#masteryModeGroup {
  background: #20283e;
  border: none;
  border-radius: 10px;
}

QPushButton#masteryMode {
  background: transparent;
  border: none;
  border-radius: 9px;
  min-height: 26px;
  max-height: 26px;
  padding: 0 7px;
  font-size: 10pt;
  font-weight: 300;
}

QPushButton#masteryMode:hover {
  background: #272f47;
}

QPushButton#masteryMode:checked {
  background: #313a58;
  color: #ffffff;
}

QWidget#summaryHeader {
  background: #313a58;
  border-radius: 8px 8px 0 0;
}

QLabel#summaryHeading {
  color: #ffffff;
  font-size: 12pt;
  font-weight: 500;
}

QWidget#settingsGroup {
  background: #20283e;
  border: none;
  border-radius: 9px;
}

QWidget#settingsRow {
  background: transparent;
  border: none;
}

QFrame#settingsSeparator {
  background: #313a58;
  border: none;
  min-height: 1px;
  max-height: 1px;
  margin-left: 16px;
}

QFrame#buildPane {
  background: #171e30;
  border: none;
  border-radius: 8px;
}

QListView#buildEquipmentList,
QListView#buildEquipmentList QWidget#qt_scrollarea_viewport,
QListView#buildSourceItemList,
QListView#buildSourceItemList QWidget#qt_scrollarea_viewport,
QListView#buildSourceList,
QListView#buildSourceList QWidget#qt_scrollarea_viewport,
QListView#buildGroupList,
QListView#buildGroupList QWidget#qt_scrollarea_viewport,
QListWidget#buildCopyList,
QListWidget#buildCopyList QWidget#qt_scrollarea_viewport,
QListWidget#buildGroupMembers,
QListWidget#buildGroupMembers QWidget#qt_scrollarea_viewport,
QListWidget#buildSlotList,
QListWidget#buildSlotList QWidget#qt_scrollarea_viewport {
  background: transparent;
  border: none;
  outline: none;
}

QListView#buildEquipmentList::item,
QListView#buildSourceItemList::item,
QListView#buildSourceList::item,
QListView#buildGroupList::item,
QListWidget#buildCopyList::item,
QListWidget#buildGroupMembers::item,
QListWidget#buildSlotList::item {
  background: #20283e;
  border: 1px solid transparent;
  border-radius: 6px;
  margin: 2px 0;
  padding: 8px 10px;
}

QListView#buildEquipmentList::item:hover,
QListView#buildSourceItemList::item:hover,
QListView#buildSourceList::item:hover,
QListView#buildGroupList::item:hover,
QListWidget#buildCopyList::item:hover {
  background: #272f47;
}

QListView#buildEquipmentList::item:selected,
QListView#buildSourceItemList::item:selected,
QListView#buildSourceList::item:selected,
QListView#buildGroupList::item:selected,
QListWidget#buildCopyList::item:selected {
  background: #2c3150;
  border-color: #8c6ee8;
  color: #ffffff;
}

QLabel#buildWorkspaceState {
  background: #101623;
  border-radius: 6px;
  color: #b8bfd3;
  padding: 10px;
}

QScrollArea#buildTopologyScroll,
QScrollArea#buildTopologyScroll QWidget#qt_scrollarea_viewport,
QWidget#buildTopology,
QWidget#buildTopologyBody {
  background: transparent;
  border: none;
}

QLabel#buildRegionTitle {
  color: #b8bfd3;
  font-size: 10pt;
  font-weight: 500;
  padding-top: 3px;
}

QFrame#buildTopologySlot {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 58px;
}

QWidget#buildSlotArtwork {
  background: transparent;
  border: none;
}

QLabel#buildSlotLabel,
QLabel#buildSlotMeta,
QLabel#buildSlotPolarity {
  color: #8a8c95;
  font-size: 9pt;
}

QLabel#buildSlotName {
  color: #ffffff;
  font-weight: 400;
}

QLabel#buildAbilityOverride {
  background: #251d3d;
  border: 1px solid #5e44af;
  border-radius: 6px;
  color: #d8cfff;
  padding: 7px 9px;
}

QLabel#settingsSectionHeading {
  color: #8a8c95;
  font-size: 9pt;
  font-weight: 500;
  padding: 0 2px;
}

QLabel#settingsHeading {
  color: #ffffff;
  font-size: 11pt;
  font-weight: 500;
}

QLabel#settingsDescription {
  color: #8a8c95;
  font-size: 9.5pt;
}

QLabel#settingsValue {
  color: #d8dbea;
}

QLabel#settingsDaemonStatus {
  color: #ff8796;
  font-weight: 500;
  max-width: 280px;
}

QLabel#settingsDaemonStatus[connected="true"] {
  color: #7edb91;
}

QLabel#settingsPath {
  color: #8a8c95;
  font-size: 9pt;
}

QLabel#settingsError {
  color: #ff8796;
}

QPushButton#clearMemoryCache,
QPushButton#clearDerivativeCache,
QPushButton#clearSourceCache {
  min-width: 64px;
}
