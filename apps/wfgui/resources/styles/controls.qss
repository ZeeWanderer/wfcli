/* Reusable controls. Page-specific variants belong with their page. */

QLineEdit {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 20px;
  padding: 5px 8px;
}

QLineEdit:focus {
  border-color: #8c6ee8;
}

QWidget#expandingSearch {
  background: #20283e;
  border-radius: 16px;
  min-height: 32px;
  max-height: 32px;
}

QLineEdit#inlineSearch {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 24px;
  padding: 0 2px;
}

QPushButton {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 20px;
  padding: 5px 10px;
}

QPushButton:hover {
  background: #272f47;
}

QPushButton:checked {
  background: #432289;
  border-color: #8c6ee8;
  color: #ffffff;
}

QPushButton:disabled {
  color: #8a8c95;
}

QPushButton#filterChip {
  min-width: 24px;
  min-height: 24px;
  border: none;
  border-radius: 16px;
  padding: 4px 9px;
}

QPushButton#filterChip[animated="true"] {
  text-align: left;
}

QToolButton#compactTool,
QPushButton#compactTool {
  background: #20283e;
  border: none;
  border-radius: 16px;
  min-width: 40px;
  max-width: 40px;
  min-height: 32px;
  max-height: 32px;
  padding: 0;
}

QToolButton#compactTool:hover,
QPushButton#compactTool:hover {
  background: #272f47;
}

QToolButton#compactTool[active="true"] {
  background: #432289;
}

QToolButton#sortDirection {
  background: #20283e;
  border: none;
  border-radius: 16px 0 0 16px;
  min-width: 34px;
  max-width: 34px;
  min-height: 32px;
  max-height: 32px;
  padding: 0;
}

QToolButton#sortDirection:hover,
QComboBox#sortSelect:hover {
  background: #272f47;
}

QComboBox#sortSelect {
  background: #20283e;
  border: none;
  border-left: 1px solid #313a58;
  border-radius: 0 16px 16px 0;
  color: #ffffff;
  min-height: 32px;
  min-width: 128px;
  padding: 0 24px 0 9px;
}

QComboBox#sortSelect::drop-down {
  border: none;
  width: 22px;
}

QComboBox#sortSelect QAbstractItemView {
  background: #171e30;
  border: 1px solid #313a58;
  color: #ffffff;
  selection-background-color: #313a58;
  outline: none;
}

QToolButton::menu-indicator {
  image: none;
}

QMenu {
  background: #171e30;
  border: 1px solid #313a58;
  border-radius: 6px;
  padding: 4px;
}

QMenu::item {
  border-radius: 4px;
  padding: 5px 22px 5px 8px;
}

QMenu::item:selected {
  background: #272f47;
}

QMenu::indicator {
  width: 13px;
  height: 13px;
}

QPushButton#railFilter {
  background: transparent;
  border: none;
  border-radius: 4px;
  min-width: 23px;
  max-width: 23px;
  min-height: 23px;
  max-height: 23px;
  padding: 1px;
}

QPushButton#railFilter:hover {
  background: #272f47;
}

QPushButton#railFilter:checked {
  background: #313a58;
}


QListView#playerItemGrid,
QListView#playerItemGrid QWidget#qt_scrollarea_viewport {
  background: transparent;
  border: none;
  outline: none;
}

QScrollBar:vertical {
  background: #101623;
  border: none;
  width: 5px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #313a58;
  border-radius: 2px;
  min-height: 30px;
}

QScrollBar::handle:vertical:hover {
  background: #4a557a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: transparent;
}

QLabel#emptyState {
  color: #8a8c95;
  padding: 40px;
}

QProgressBar {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 3px;
  min-height: 7px;
  max-height: 7px;
}

QProgressBar::chunk {
  background: #5e44af;
}

QProgressBar#priceProgress {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 2px;
  max-height: 2px;
}

QProgressBar#priceProgress::chunk {
  background: #5e44af;
}

QCheckBox {
  spacing: 5px;
}

QCheckBox#ownedToggle {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0 2px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #66708f;
  border-radius: 3px;
  background: #20283e;
}

QCheckBox::indicator:checked {
  background: #5e44af;
  border-color: #8c6ee8;
  image: url(:/resources/market/wfgui-check.png);
}
