/* Typography and application shell. Layout-only QWidget containers stay transparent. */

QWidget {
  color: #ffffff;
  font-family: "Roboto";
  font-size: 10pt;
  font-weight: 400;
}

.QWidget {
  background: transparent;
}

QDialog {
  background: #101623;
}

QWidget#appRoot,
QWidget#sidebar {
  background: #101623;
}

QWidget#windowRoot {
  background: #101623;
  border: 1px solid #313a58;
}

QWidget#titleBar {
  background: transparent;
  border: none;
}

QLabel#windowTitle {
  color: #d8dbea;
  font-size: 11pt;
}

QToolButton#titleScaleStep {
  background: transparent;
  border: none;
  border-radius: 10px;
  min-width: 25px;
  max-width: 25px;
  min-height: 25px;
  max-height: 25px;
  padding: 0;
}

QToolButton#titleRailToggle {
  background: transparent;
  border: none;
  border-radius: 6px;
  min-width: 28px;
  max-width: 28px;
  min-height: 28px;
  max-height: 28px;
  padding: 0;
}

QToolButton#windowControl,
QToolButton#windowClose {
  background: transparent;
  border: none;
  border-radius: 6px;
  min-width: 30px;
  max-width: 30px;
  min-height: 30px;
  max-height: 30px;
  padding: 0;
}

QToolButton#titleScaleStep:hover,
QToolButton#titleRailToggle:hover,
QToolButton#windowControl:hover {
  background: #313a58;
}

QToolButton#windowClose:hover {
  background: #a73746;
}

QLabel#titleScaleValue {
  color: #d8dbea;
  min-width: 38px;
  max-width: 38px;
  font-size: 10pt;
}

QStackedWidget#centerRail {
  background: #171e30;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

QWidget#activityRail {
  background: #171e30;
  border-radius: 10px;
}

QWidget#page {
  background: transparent;
}

QWidget#contentFrame,
QWidget#contentHost {
  background: transparent;
}

QLabel {
  background: transparent;
}

QLabel#wfguiTooltip {
  background: #2a3248;
  border: 1px solid #59637a;
  border-radius: 4px;
  color: #ffffff;
  padding: 5px 7px;
}

QWidget#playerIdentity {
  background: #171e30;
  border-radius: 8px;
}

QWidget#playerEmblem {
  background: transparent;
}

QLabel#playerRankBadge {
  background: rgba(0, 0, 0, 199);
  border: none;
  border-radius: 6px;
  color: #ffffff;
  font-size: 11pt;
  font-weight: 500;
  padding: 1px 4px;
}

QLabel#playerName {
  color: #ffffff;
  font-size: 10pt;
  font-weight: 400;
}

QPushButton#navigation {
  background: transparent;
  color: #8a8c95;
  border: none;
  border-radius: 0;
  min-height: 34px;
  padding: 0 5px 0 8px;
  text-align: left;
  font-size: 11pt;
  font-weight: 300;
}

QPushButton#navigation:hover {
  color: #d8dbea;
  border-right: 3px solid #d8dbea;
}

QPushButton#navigation:checked {
  background: transparent;
  color: #ffffff;
  border-right: 3px solid #ffffff;
}

QPushButton#navigation[multiline="true"] {
  min-height: 44px;
}

QPushButton#navigation[collapsed="true"] {
  min-height: 38px;
  max-height: 38px;
  padding: 0;
  text-align: center;
}

QLabel#secondaryText {
  color: #8a8c95;
}

QLabel#pageError {
  color: #ff8796;
}

QLabel#pageTitle {
  font-size: 20pt;
  font-weight: 300;
}

QLabel#masteryRank {
  font-size: 38pt;
  font-weight: 300;
  min-width: 48px;
}

QWidget#masteryTop {
  background: transparent;
}

QLabel#masteryProgressLabel {
  color: #ffffff;
  font-size: 12pt;
  font-weight: 400;
}

QProgressBar#masteryProgress {
  background: #20283e;
  border: none;
  border-radius: 9px;
  min-height: 19px;
  max-height: 19px;
}

QProgressBar#masteryProgress::chunk {
  background: #5923cb;
  border-radius: 9px;
}

QLabel#sectionTitle {
  font-size: 13pt;
  font-weight: 400;
}
