QWidget {
  background: #101623;
  color: #ffffff;
  font-family: "Roboto";
  font-size: 10pt;
  font-weight: 400;
}

QWidget#appRoot,
QWidget#sidebar {
  background: #101623;
}

QWidget#windowRoot {
  background: #101623;
  border: 1px solid #313a58;
}

QWidget#titleBar {
  background: transparent;
  border: none;
}

QLabel#windowTitle {
  color: #d8dbea;
  font-size: 11pt;
}

QToolButton#titleScaleStep {
  background: transparent;
  border: none;
  border-radius: 10px;
  min-width: 25px;
  max-width: 25px;
  min-height: 25px;
  max-height: 25px;
  padding: 0;
}

QToolButton#titleRailToggle {
  background: transparent;
  border: none;
  border-radius: 6px;
  min-width: 28px;
  max-width: 28px;
  min-height: 28px;
  max-height: 28px;
  padding: 0;
}

QToolButton#windowControl,
QToolButton#windowClose {
  background: transparent;
  border: none;
  border-radius: 6px;
  min-width: 30px;
  max-width: 30px;
  min-height: 30px;
  max-height: 30px;
  padding: 0;
}

QToolButton#titleScaleStep:hover,
QToolButton#titleRailToggle:hover,
QToolButton#windowControl:hover {
  background: #313a58;
}

QToolButton#windowClose:hover {
  background: #a73746;
}

QLabel#titleScaleValue {
  color: #d8dbea;
  min-width: 38px;
  max-width: 38px;
  font-size: 10pt;
}

QStackedWidget#centerRail {
  background: #171e30;
  border-top-left-radius: 10px;
  border-top-right-radius: 10px;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

QWidget#activityRail {
  background: #171e30;
  border-radius: 10px;
}

QWidget#page {
  background: transparent;
}

QWidget#contentFrame,
QWidget#contentHost {
  background: transparent;
}

QLabel {
  background: transparent;
}

QWidget#playerIdentity {
  background: #171e30;
  border-radius: 8px;
}

QWidget#playerEmblem {
  background: transparent;
}

QLabel#playerRankBadge {
  background: rgba(0, 0, 0, 199);
  border: none;
  border-radius: 6px;
  color: #ffffff;
  font-size: 11pt;
  font-weight: 500;
  padding: 1px 4px;
}

QLabel#playerName {
  color: #ffffff;
  font-size: 10pt;
  font-weight: 400;
}

QPushButton#navigation {
  background: transparent;
  color: #8a8c95;
  border: none;
  border-radius: 0;
  min-height: 34px;
  padding: 0 5px 0 8px;
  text-align: left;
  font-size: 11pt;
  font-weight: 300;
}

QPushButton#navigation:hover {
  color: #d8dbea;
  border-right: 3px solid #d8dbea;
}

QPushButton#navigation:checked {
  background: transparent;
  color: #ffffff;
  border-right: 3px solid #ffffff;
}

QPushButton#navigation[multiline="true"] {
  min-height: 44px;
}

QPushButton#navigation[collapsed="true"] {
  min-height: 38px;
  max-height: 38px;
  padding: 0;
  text-align: center;
}

QLabel#daemonStatus,
QLabel#secondaryText {
  color: #8a8c95;
}

QLabel#daemonStatus {
  font-size: 9pt;
}

QLabel#daemonStatus[connected="true"] {
  color: #7edb91;
}

QLabel#pageTitle {
  font-size: 20pt;
  font-weight: 300;
}

QLabel#masteryRank {
  font-size: 38pt;
  font-weight: 300;
  min-width: 48px;
}

QWidget#masteryTop {
  background: transparent;
}

QLabel#masteryProgressLabel {
  color: #ffffff;
  font-size: 12pt;
  font-weight: 400;
}

QProgressBar#masteryProgress {
  background: #20283e;
  border: none;
  border-radius: 9px;
  min-height: 19px;
  max-height: 19px;
}

QProgressBar#masteryProgress::chunk {
  background: #5923cb;
  border-radius: 9px;
}

QLabel#sectionTitle {
  font-size: 13pt;
  font-weight: 400;
}

QWidget#railTabHeader {
  background: transparent;
  border-bottom: 1px solid #313a58;
  min-height: 33px;
  max-height: 33px;
}

QWidget#railTab {
  background: transparent;
  border-bottom: 3px solid transparent;
}

QWidget#railTab[selected="true"] {
  border-bottom-color: #ffffff;
}

QLabel#railTabText {
  color: #8a8c95;
  font-size: 12pt;
  font-weight: 300;
}

QLabel#railTabText[selected="true"] {
  color: #ffffff;
}

QWidget#activityBody {
  background: transparent;
}

QLabel#cycleName {
  color: #aeb5c7;
  font-size: 10.5pt;
  font-weight: 300;
}

QLabel#cycleState {
  color: #ffffff;
  font-weight: 500;
  font-size: 12pt;
}

QWidget#fissureName {
  background: transparent;
}

QLabel#fissureMissionType,
QLabel#fissureLocation {
  color: #ffffff;
  font-size: 10.5pt;
}

QLabel#fissureMissionType {
  font-weight: 500;
}

QLabel#fissureLocation {
  font-weight: 300;
}

QLabel#countdown {
  color: #ffffff;
  font-size: 11pt;
  font-weight: 400;
}

QWidget#resurgencePill {
  background: transparent;
  min-width: 148px;
}

QWidget#baroPill {
  background: transparent;
  min-width: 104px;
}

QLineEdit {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 20px;
  padding: 5px 8px;
}

QLineEdit:focus {
  border-color: #8c6ee8;
}

QWidget#expandingSearch {
  background: #20283e;
  border-radius: 16px;
  min-height: 32px;
  max-height: 32px;
}

QLineEdit#inlineSearch {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 24px;
  padding: 0 2px;
}

QPushButton {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 20px;
  padding: 5px 10px;
}

QPushButton:hover {
  background: #272f47;
}

QPushButton:checked {
  background: #432289;
  border-color: #8c6ee8;
  color: #ffffff;
}

QPushButton:disabled {
  color: #8a8c95;
}

QPushButton#filterChip {
  min-width: 24px;
  min-height: 24px;
  border: none;
  border-radius: 16px;
  padding: 4px 9px;
}

QPushButton#filterChip[animated="true"] {
  text-align: left;
}

QToolButton#compactTool,
QPushButton#compactTool {
  background: #20283e;
  border: none;
  border-radius: 16px;
  min-width: 40px;
  max-width: 40px;
  min-height: 32px;
  max-height: 32px;
  padding: 0;
}

QToolButton#compactTool:hover,
QPushButton#compactTool:hover {
  background: #272f47;
}

QToolButton#compactTool[active="true"] {
  background: #432289;
}

QToolButton#sortDirection {
  background: #20283e;
  border: none;
  border-radius: 16px 0 0 16px;
  min-width: 34px;
  max-width: 34px;
  min-height: 32px;
  max-height: 32px;
  padding: 0;
}

QToolButton#sortDirection:hover,
QComboBox#sortSelect:hover {
  background: #272f47;
}

QComboBox#sortSelect {
  background: #20283e;
  border: none;
  border-left: 1px solid #313a58;
  border-radius: 0 16px 16px 0;
  color: #ffffff;
  min-height: 32px;
  min-width: 128px;
  padding: 0 24px 0 9px;
}

QComboBox#sortSelect::drop-down {
  border: none;
  width: 22px;
}

QComboBox#sortSelect QAbstractItemView {
  background: #171e30;
  border: 1px solid #313a58;
  color: #ffffff;
  selection-background-color: #313a58;
  outline: none;
}

QToolButton::menu-indicator {
  image: none;
}

QMenu {
  background: #171e30;
  border: 1px solid #313a58;
  border-radius: 6px;
  padding: 4px;
}

QMenu::item {
  border-radius: 4px;
  padding: 5px 22px 5px 8px;
}

QMenu::item:selected {
  background: #272f47;
}

QMenu::indicator {
  width: 13px;
  height: 13px;
}

QPushButton#railFilter {
  background: transparent;
  border: none;
  border-radius: 4px;
  min-width: 23px;
  max-width: 23px;
  min-height: 23px;
  max-height: 23px;
  padding: 1px;
}

QPushButton#railFilter:hover {
  background: #272f47;
}

QPushButton#railFilter:checked {
  background: #313a58;
}

QWidget#contentFrame {
  background: transparent;
  border: none;
}

QWidget#summaryPanel {
  background: #20283e;
  border: none;
  border-radius: 8px;
}

QWidget#masterySummaryPanel {
  background: #20283e;
  border: none;
  border-radius: 10px;
}

QWidget#masterySummaryHeader {
  background: #313a58;
  border-radius: 10px 10px 0 0;
  min-height: 40px;
  max-height: 40px;
}

QLabel#masterySummaryHeading {
  color: #ffffff;
  font-size: 12pt;
  font-weight: 400;
}

QLabel#masterySummaryPercent {
  color: #b59dff;
  font-size: 12pt;
  font-weight: 400;
}

QLabel#masterySummaryRowLabel {
  color: #ffffff;
  font-size: 11pt;
  font-weight: 400;
}

QLabel#masterySummaryRowValue {
  color: #ffffff;
  font-size: 10.5pt;
  font-weight: 300;
}

QWidget#masteryBottom {
  background: #101623;
  border: none;
  border-top-left-radius: 15px;
  border-top-right-radius: 15px;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

QLabel#masterySectionTitle {
  color: #ffffff;
  font-size: 13pt;
  font-weight: 400;
}

QWidget#masteryModeGroup {
  background: #20283e;
  border: none;
  border-radius: 10px;
}

QPushButton#masteryMode {
  background: transparent;
  border: none;
  border-radius: 9px;
  min-height: 26px;
  max-height: 26px;
  padding: 0 7px;
  font-size: 10pt;
  font-weight: 300;
}

QPushButton#masteryMode:hover {
  background: #272f47;
}

QPushButton#masteryMode:checked {
  background: #313a58;
  color: #ffffff;
}

QWidget#summaryHeader {
  background: #313a58;
  border-radius: 8px 8px 0 0;
}

QLabel#summaryHeading {
  color: #ffffff;
  font-size: 12pt;
  font-weight: 500;
}

QWidget#cycleCard {
  background: #101623;
  border: none;
  border-radius: 25px;
  min-height: 50px;
  max-height: 50px;
}

QLabel#cycleIcon {
  background: #20283e;
  border-radius: 24px;
}

QWidget#fissureSection {
  background: #101623;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
}

QWidget#fissureHeader {
  background: #20283e;
  border-top-left-radius: 8px;
  border-top-right-radius: 8px;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
  min-height: 26px;
}

QWidget#notificationControl,
QAbstractButton#notificationMode {
  background: transparent;
  border: none;
}

QWidget#fissureGroup {
  background: #171e30;
  border: none;
  border-radius: 8px;
}

QWidget#fissureRow {
  background: transparent;
}

QLabel#summaryValue {
  font-size: 11pt;
  font-weight: 500;
}

QScrollArea#relicScroll,
QScrollArea#relicScroll QWidget#qt_scrollarea_viewport,
QScrollArea#activityScroll,
QScrollArea#activityScroll QWidget#qt_scrollarea_viewport,
QWidget#relicGrid,
QWidget#relicCardCanvas {
  background: transparent;
  border: none;
}

QWidget#fissureList {
  background: #101623;
  border: none;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  border-bottom-left-radius: 12px;
  border-bottom-right-radius: 12px;
}

QListView#playerItemGrid,
QListView#playerItemGrid QWidget#qt_scrollarea_viewport {
  background: transparent;
  border: none;
  outline: none;
}

QScrollBar:vertical {
  background: #101623;
  border: none;
  width: 5px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #313a58;
  border-radius: 2px;
  min-height: 30px;
}

QScrollBar::handle:vertical:hover {
  background: #4a557a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: transparent;
}

QLabel#emptyState {
  color: #8a8c95;
  padding: 40px;
}

QProgressBar {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 3px;
  min-height: 7px;
  max-height: 7px;
}

QProgressBar::chunk {
  background: #5e44af;
}

QProgressBar#priceProgress {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 2px;
  max-height: 2px;
}

QProgressBar#priceProgress::chunk {
  background: #5e44af;
}

QCheckBox {
  spacing: 5px;
}

QCheckBox#ownedToggle {
  background: #20283e;
  border-radius: 16px;
  padding: 5px 9px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #66708f;
  border-radius: 3px;
  background: #20283e;
}

QCheckBox::indicator:checked {
  background: #5e44af;
  border-color: #8c6ee8;
}
