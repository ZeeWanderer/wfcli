QWidget {
  background: #101623;
  color: #ffffff;
  font-family: "Roboto";
  font-size: 10pt;
}

QWidget#sidebar,
QWidget#activityRail,
QWidget#page {
  background: #171e30;
}

QLabel {
  background: transparent;
}

QLabel#brand {
  font-size: 15pt;
  font-weight: 600;
}

QPushButton#navigation {
  background: transparent;
  color: #8a8c95;
  border: none;
  border-radius: 0;
  min-height: 34px;
  padding: 0 8px;
  text-align: left;
  font-weight: 500;
}

QPushButton#navigation:hover {
  color: #d8dbea;
  border-right: 3px solid #d8dbea;
}

QPushButton#navigation:checked {
  background: transparent;
  color: #ffffff;
  border-right: 3px solid #ffffff;
}

QLabel#daemonStatus,
QLabel#secondaryText {
  color: #8a8c95;
}

QLabel#daemonStatus[connected="true"] {
  color: #7edb91;
}

QLabel#pageTitle {
  font-size: 18pt;
  font-weight: 600;
}

QLabel#masteryRank {
  font-size: 30pt;
  font-weight: 400;
  padding: 0 8px 0 0;
}

QLabel#railTitle,
QLabel#sectionTitle {
  font-size: 11pt;
  font-weight: 600;
}

QLabel#cycleName,
QLabel#fissureTier {
  color: #aeb5c7;
  font-size: 9pt;
  font-weight: 600;
}

QLabel#cycleState,
QLabel#fissureMission {
  color: #ffffff;
  font-weight: 600;
}

QLabel#countdown {
  color: #ffffff;
}

QLabel#baroStatus,
QLabel#resurgenceStatus,
QLabel#inventoryTotals {
  background: #101623;
  border-radius: 7px;
  padding: 7px 9px;
}

QLineEdit {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 20px;
  padding: 5px 8px;
}

QLineEdit:focus {
  border-color: #8c6ee8;
}

QPushButton {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 6px;
  min-height: 20px;
  padding: 5px 10px;
}

QPushButton:hover {
  background: #272f47;
}

QPushButton:checked {
  background: #432289;
  border-color: #8c6ee8;
  color: #ffffff;
}

QPushButton:disabled {
  color: #8a8c95;
}

QPushButton#filterChip {
  min-width: 24px;
  padding: 4px 7px;
}

QPushButton#railFilter {
  min-height: 18px;
  padding: 3px 6px;
}

QWidget#contentFrame {
  background: transparent;
  border: none;
}

QWidget#summaryPanel,
QWidget#cycleCard,
QWidget#fissureRow {
  background: #20283e;
  border: none;
  border-radius: 8px;
}

QLabel#summaryValue {
  font-size: 11pt;
  font-weight: 500;
}

QScrollArea#relicScroll,
QScrollArea#relicScroll QWidget#qt_scrollarea_viewport,
QScrollArea#activityScroll,
QScrollArea#activityScroll QWidget#qt_scrollarea_viewport,
QWidget#fissureList,
QWidget#relicGrid,
QWidget#relicCardCanvas {
  background: transparent;
  border: none;
}

QListView#playerItemGrid,
QListView#playerItemGrid QWidget#qt_scrollarea_viewport {
  background: transparent;
  border: none;
  outline: none;
}

QScrollBar:vertical {
  background: #101623;
  border: none;
  width: 5px;
  margin: 0;
}

QScrollBar::handle:vertical {
  background: #313a58;
  border-radius: 2px;
  min-height: 30px;
}

QScrollBar::handle:vertical:hover {
  background: #4a557a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
  background: transparent;
}

QLabel#emptyState {
  color: #8a8c95;
  padding: 40px;
}

QProgressBar {
  background: #20283e;
  border: 1px solid #313a58;
  border-radius: 3px;
  min-height: 7px;
  max-height: 7px;
}

QProgressBar::chunk {
  background: #5e44af;
}

QProgressBar#priceProgress {
  background: transparent;
  border: none;
  border-radius: 0;
  min-height: 2px;
  max-height: 2px;
}

QProgressBar#priceProgress::chunk {
  background: #5e44af;
}

QCheckBox {
  spacing: 5px;
}

QCheckBox::indicator {
  width: 14px;
  height: 14px;
  border: 1px solid #66708f;
  border-radius: 3px;
  background: #20283e;
}

QCheckBox::indicator:checked {
  background: #5e44af;
  border-color: #8c6ee8;
}
