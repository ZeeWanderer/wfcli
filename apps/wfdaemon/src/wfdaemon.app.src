{application, wfdaemon, [
    {description, "Persistent wfcli data and planning service"},
    {vsn, {file, "../../VERSION"}},
    {registered, [wfcli_sup, wfcli_daemon, wfcli_worldstate_service,
                  wfcli_exports_store, wfcli_source_manager, wfcli_query_service,
                  wfcli_forma_service, wfcli_player_service,
                  wfcli_resolution_issues, wfcli_build_service,
                  wfcli_market_limiter,
                  wfcli_market_service, wfcli_market_account_service,
                  wfcli_market_presence_service,
                  wfcli_asset_service, wfcli_notification_service,
                  wfcli_local_api]},
    {mod, {wfdaemon_app, []}},
    {applications, [kernel, stdlib, wfcore, crypto, yamerl, jsone, inets, ssl, gun]},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, []}
]}.
