#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-}"

case "$mode" in
    dev) profile=default ;;
    prod) profile=prod ;;
    *)
        printf 'usage: %s dev|prod\n' "$0" >&2
        exit 2
        ;;
esac

profile_dir="$root/_build/$profile"
release="$profile_dir/rel/wfdaemon"

if [[ ! -x "$profile_dir/bin/wfcli" || ! -x "$release/bin/wfdaemon" ]]; then
    printf 'missing %s Erlang build; run make %s-erlang first\n' "$mode" "$mode" >&2
    exit 1
fi

source "$root/scripts/lib/staging.sh"
stage_begin "$root/$mode"
mkdir -p "$stage/bin" "$stage/libexec"
rm -rf "$stage/libexec/wfdaemon" "$stage/libexec/wfcli"
mkdir -p "$stage/libexec/wfcli"
install -m 0755 "$profile_dir/bin/wfcli" "$stage/libexec/wfcli/wfcli.escript"
install -m 0755 "$root/scripts/wfcli-wrapper" "$stage/bin/wfcli"
cp -a --reflink=auto "$release" "$stage/libexec/wfdaemon"
install -m 0755 "$root/scripts/wfdaemon-wrapper" "$stage/bin/wfdaemon"
printf '%s\n' "$mode" > "$stage/BUILD_FLAVOR"

completion_dir="$stage/share/bash-completion/completions"
rm -rf "$completion_dir"
mkdir -p "$completion_dir"
"$stage/bin/wfcli" completion bash > "$completion_dir/wfcli.bash"
cp "$completion_dir/wfcli.bash" "$completion_dir/wfclid.bash"

core_ebin=("$stage"/libexec/wfdaemon/lib/wfcore-*/ebin)
daemon_ebin=("$stage"/libexec/wfdaemon/lib/wfdaemon-*/ebin)
identity="$(
    WFCLI_CORE_EBIN="${core_ebin[0]}" WFCLI_DAEMON_EBIN="${daemon_ebin[0]}" \
        erl -pa "${daemon_ebin[0]}" -noshell -eval '
        Dirs = [os:getenv("WFCLI_CORE_EBIN"), os:getenv("WFCLI_DAEMON_EBIN")],
        {ok, Bundles} = wfcli_hot_update:read_directories(Dirs),
        {ok, Identity} = wfcli_hot_update:build_identity(Bundles),
        io:put_chars(Identity),
        halt().
    '
)"
printf '%s\n' "$identity" > "$stage/BUILD_ID"
stage_commit
