#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-dev}"
case "$mode" in
    dev) profile=debug; cargo_args=() ;;
    prod) profile=release; cargo_args=(--release) ;;
    *) printf 'usage: %s dev|prod\n' "$0" >&2; exit 2 ;;
esac

version=0.5.5
checksum=0812195e10763135833def9f2d1ee3c1816a06c9d789d1f1026faafc7156e65c
archive="$root/.cache/downloads/oozextract-$version.crate"
source_dir="$root/.cache/tools/oozextract-$version"
target_dir="${CARGO_TARGET_DIR:-$root/_build/cargo}/oozextract"

mkdir -p "$(dirname "$archive")" "$(dirname "$source_dir")"
exec 9>"$root/.cache/tools/oozextract.lock"
flock 9
if [[ ! -f "$archive" ]]; then
    temporary="$(mktemp "$archive.XXXXXX")"
    trap 'rm -f "$temporary"' EXIT
    curl --fail --location --retry 3 --max-time 120 \
        "https://static.crates.io/crates/oozextract/oozextract-$version.crate" \
        --output "$temporary"
    printf '%s  %s\n' "$checksum" "$temporary" | sha256sum --check --status
    mv "$temporary" "$archive"
fi
printf '%s  %s\n' "$checksum" "$archive" | sha256sum --check --status
if [[ ! -f "$source_dir/.unpacked" ]]; then
    tar -xzf "$archive" -C "$(dirname "$source_dir")"
    touch "$source_dir/.unpacked"
fi
flock -u 9

CARGO_TARGET_DIR="$target_dir" CARGO_PROFILE_RELEASE_STRIP=true \
    cargo build "${cargo_args[@]}" --locked --manifest-path "$source_dir/Cargo.toml" \
        --features cli --bin unoodle

licenses="$target_dir/$profile/licenses/oozextract"
rm -rf "$licenses"
mkdir -p "$licenses"
install -m 0644 "$archive" "$licenses/"
install -m 0644 "$root/apps/wfcompanion/assets/Oozextract-LICENSE.txt" \
    "$licenses/LICENSE.txt"
