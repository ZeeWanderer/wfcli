#!/usr/bin/env bash
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
    directory="$(cd -P "$(dirname "$script")" && pwd)"
    target="$(readlink "$script")"
    case "$target" in
        /*) script="$target" ;;
        *) script="$directory/$target" ;;
    esac
done

root="$(cd -P "$(dirname "$script")/.." && pwd)"
flavor="$(tr -d '\r\n' < "$root/BUILD_FLAVOR")"
export WFCLI_BUILD_FLAVOR="$flavor"
export WFCLI_INSTALL_ROOT="$root"
exec "$root/libexec/wfdaemon/bin/wfdaemon" "$@"
