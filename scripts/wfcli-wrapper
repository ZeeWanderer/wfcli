#!/usr/bin/env bash
set -euo pipefail

script="${BASH_SOURCE[0]}"
while [[ -L "$script" ]]; do
    directory="$(cd -P "$(dirname "$script")" && pwd)"
    target="$(readlink "$script")"
    case "$target" in
        /*) script="$target" ;;
        *) script="$directory/$target" ;;
    esac
done

root="$(cd -P "$(dirname "$script")/.." && pwd)"
erts_bins=("$root"/libexec/wfdaemon/erts-*/bin)
if [[ ${#erts_bins[@]} -ne 1 || ! -x "${erts_bins[0]}/escript" ]]; then
    printf 'wfcli: bundled Erlang runtime not found under %s\n' "$root/libexec/wfdaemon" >&2
    exit 1
fi

flavor="$(tr -d '\r\n' < "$root/BUILD_FLAVOR")"
export WFCLI_BUILD_FLAVOR="$flavor"
export WFCLI_INSTALL_ROOT="$root"
export PATH="${erts_bins[0]}:${PATH:-/usr/bin:/bin}"

exec "${erts_bins[0]}/escript" "$root/libexec/wfcli/wfcli.escript" "$@"
