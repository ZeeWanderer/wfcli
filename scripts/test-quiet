#!/usr/bin/env bash
set -uo pipefail

command_name="${1:-ct}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    ct|eunit) ;;
    *)
        printf 'usage: %s [ct|eunit] [rebar3 options...]\n' "$0" >&2
        exit 2
        ;;
esac

log_file="$(mktemp "${TMPDIR:-/tmp}/wfcli-${command_name}.XXXXXX.log")"
rebar3 "$command_name" "$@" >"$log_file" 2>&1
status=$?
if [[ $status -eq 0 ]]; then
    printf 'rebar3 %s: passed\n' "$command_name"
    rm -f "$log_file"
    exit 0
fi

printf 'rebar3 %s: failed (full log: %s)\n' "$command_name" "$log_file" >&2
perl -pe 's/\e\[[0-9;]*m//g' "$log_file" \
    | awk 'length($0) > 400 && $0 ~ /^\.+$/ { next } { print }' \
    | tail -n 120 >&2
exit "$status"
