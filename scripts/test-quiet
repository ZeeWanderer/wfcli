#!/usr/bin/env bash
set -uo pipefail

command_name="${1:-ct}"
if [[ $# -gt 0 ]]; then
    shift
fi

case "$command_name" in
    ct|eunit|gui|release) ;;
    *)
        printf 'usage: %s [ct|eunit|gui|release] [options...]\n' "$0" >&2
        exit 2
        ;;
esac

log_file="$(mktemp "${TMPDIR:-/tmp}/wfcli-${command_name}.XXXXXX.log")"
if [[ "$command_name" == "gui" ]]; then
    label="gui"
    make gui-dev >"$log_file" 2>&1 &&
        ctest --test-dir _build/cmake/gui-dev --output-on-failure >>"$log_file" 2>&1
elif [[ "$command_name" == "release" ]]; then
    label="release portability"
    ./scripts/test-release-portability >"$log_file" 2>&1
else
    label="rebar3 $command_name"
    rebar3 "$command_name" "$@" >"$log_file" 2>&1
fi
status=$?
if [[ $status -eq 0 ]]; then
    printf '%s: passed\n' "$label"
    rm -f "$log_file"
    exit 0
fi

printf '%s: failed (full log: %s)\n' "$label" "$log_file" >&2
perl -pe 's/\e\[[0-9;]*m//g' "$log_file" \
    | awk 'length($0) > 400 && $0 ~ /^\.+$/ { next } { print }' \
    | tail -n 120 >&2
exit "$status"
