#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-dev}"
manifest="$root/apps/wfcompanion/Cargo.toml"
target_dir="${CARGO_TARGET_DIR:-$root/_build/cargo}"
stage="$root/$mode"
debug_bridge="$stage/libexec/wfcompanion-debug-output.exe"
tesseract_bin="$(command -v tesseract || true)"

case "$mode" in
    dev)
        cargo_profile=debug
        cargo_args=()
        cpu_baseline="${WFCLI_CPU_BASELINE:-}"
        ;;
    prod)
        cargo_profile=release
        cargo_args=(--release)
        # Warframe requires SSE4.2; v2 keeps release artifacts portable across supported CPUs.
        case "$(uname -m)" in
            x86_64) cpu_baseline="${WFCLI_CPU_BASELINE:-x86-64-v2}" ;;
            *) cpu_baseline="${WFCLI_CPU_BASELINE:-}" ;;
        esac
        ;;
    *)
        printf 'usage: %s dev|prod\n' "$0" >&2
        exit 2
        ;;
esac

rustflags="${RUSTFLAGS:-}"
if [[ -n "$cpu_baseline" ]]; then
    rustflags="${rustflags:+$rustflags }-Ctarget-cpu=$cpu_baseline -Clink-arg=-march=$cpu_baseline"
fi

mkdir -p "$stage/bin" "$stage/libexec"
"$root/scripts/build-debug-bridge" "$debug_bridge"
WFCOMPANION_BUILD_DEBUG_BRIDGE="$debug_bridge" \
    WFCOMPANION_BUILD_TESSERACT="$tesseract_bin" \
    WFCLI_CPU_BASELINE="$cpu_baseline" \
    RUSTFLAGS="$rustflags" \
    CARGO_TARGET_DIR="$target_dir" \
    cargo build "${cargo_args[@]}" --locked --manifest-path "$manifest"
install -m 0755 "$target_dir/$cargo_profile/wfcompanion" "$stage/bin/wfcompanion"
printf '%s\n' "$stage/bin/wfcompanion"
