#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode="${1:-}"
case "$mode" in
    dev|prod) ;;
    *) printf 'usage: %s dev|prod\n' "$0" >&2; exit 2 ;;
esac

source "$root/scripts/lib/staging.sh"
stage_begin "$root/$mode"
rm -rf "${stage:?}/lib" "$stage/Qt6"
cmake --install "$root/_build/cmake/gui-$mode" --prefix "$stage"
stage_commit
